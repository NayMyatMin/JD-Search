# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit it.

# OpenAI API key — used for extraction + scoring.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-key-here...

# Gmail address you'll send the digest from / to.
GMAIL_USER=you@gmail.com

# App password (NOT your normal Gmail password).
# Generate at https://myaccount.google.com/apppasswords
# Looks like: xxxx xxxx xxxx xxxx
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the digest is delivered. Usually the same as GMAIL_USER.
EMAIL_TO=you@gmail.com
